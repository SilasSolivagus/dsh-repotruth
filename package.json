{
  "name": "dsh-plugin-repotruth",
  "version": "0.3.0",
  "description": "把代码仓库整理成产品经理能读懂的「系统现状」：接入仓库 → 内容寻址索引 → 问一句出材料 → 覆盖率表。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/paths.js",
    "lib/branding.js",
    "lib/scan.js",
    "lib/render.js",
    "lib/demo.js",
    "lib/git.js",
    "lib/indexer.js",
    "lib/worker.js",
    "lib/jobs.js",
    "lib/repos.js",
    "lib/ask.js",
    "lib/answer.js",
    "bin/dsh-plugin-repotruth.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "code-index",
    "content-addressed",
    "product-management",
    "pm",
    "repo-summary"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "bin": {
    "dsh-plugin-repotruth": "./bin/dsh-plugin-repotruth.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node ./bin/dsh-plugin-repotruth.js demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilasSolivagus/dsh-repotruth.git"
  },
  "homepage": "https://github.com/SilasSolivagus/dsh-repotruth",
  "bugs": {
    "url": "https://github.com/SilasSolivagus/dsh-repotruth/issues"
  }
}
